# Copy to .env and fill in values — never commit .env to git.
#
# Run locally:
#   cp .env.example .env  →  edit .env  →  docker compose up --build

# Used by docker compose to start MongoDB with credentials
MONGO_USER=lboevset
MONGO_PASS=20011966

# Used by the Go API to connect to MongoDB
# For docker compose: mongodb://<MONGO_USER>:<MONGO_PASS>@mongo:27017
# For local Go run:   mongodb://<MONGO_USER>:<MONGO_PASS>@localhost:27017
MONGODB_URI=mongodb://MONGO_USER:MONGO_PASS@mongo:27017
MONGODB_DB=assignment

JWT_SECRET=supersecret
